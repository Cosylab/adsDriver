# Test database for waveform/array data types

# SINT array - asynInt8ArrayIn/Out
record(waveform, "$(P):sint_arr_in") {
    field(DESC, "SINT array input")
    field(DTYP, "asynInt8ArrayIn")
    field(SCAN, "I/O Intr")
    field(INP,  "@asyn($(PORT) 0 0) SINT[] N=10 R P=$(ADS_PORT) V=TestPlan.sint_in_array")
    field(FTVL, "CHAR")
    field(NELM, "10")
    field(UDFS, "NO_ALARM")
}

record(waveform, "$(P):sint_arr_out") {
    field(DESC, "SINT array output")
    field(DTYP, "asynInt8ArrayOut")
    field(INP,  "@asyn($(PORT) 0 0) SINT[] N=10 W P=$(ADS_PORT) V=TestPlan.sint_out_array")
    field(FTVL, "CHAR")
    field(NELM, "10")
    field(UDFS, "NO_ALARM")
    info(asyn:READBACK, "1")
}

