# Test database for scalar data types

# BOOL type - bi/bo records
record(bi, "$(P):bool_in") {
    field(DESC, "BOOL input")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP,  "@asyn($(PORT) 0 0) BOOL R P=$(ADS_PORT) V=TestPlan.bi")
    field(ZNAM, "False")
    field(ONAM, "True")
    field(UDFS, "NO_ALARM")
}

record(bo, "$(P):bool_out") {
    field(DESC, "BOOL output")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT) 0 0) BOOL W P=$(ADS_PORT) V=TestPlan.bo")
    field(ZNAM, "False")
    field(ONAM, "True")
    field(UDFS, "NO_ALARM")
    info(asyn:READBACK, "1")
}

